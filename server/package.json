{
  "name": "outpost-server",
  "version": "1.0.0",
  "description": "High-concurrency backend for Outpost - Shared World Resource & Automation Game",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/db/initDb.js",
    "test:concurrency": "node tests/concurrency-race.js",
    "test:rollback": "node tests/trade-rollback.js",
    "test:scale": "node tests/seed-scale.js",
    "test:machine": "node tests/machine-concurrency.js",
    "test:all": "npm run test:concurrency && npm run test:rollback && npm run test:scale && npm run test:machine"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
